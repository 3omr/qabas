{
  "name": "@deepseek-ai/dsh-focus-timer",
  "description": "Optional local focus timer for the Harness sidebar",
  "version": "0.1.5-rc.5",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/Bestbbb/deepseek-harness-desktop.git", "directory": "packages/desktop/focus-timer" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "lib/types/**/*.d.ts"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"] }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^" },
  "dependencies": { "@deepseek-ai/schemastery": "workspace:^" },
  "bundledDependencies": ["@deepseek-ai/schemastery"],
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-bundle-marketplace": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
