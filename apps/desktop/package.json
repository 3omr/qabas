{
  "name": "@deepseek-ai/dsh-desktop-app",
  "description": "Tauri desktop carrier for the DeepSeek Harness Web profile",
  "version": "0.1.5-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bestbbb/deepseek-harness-desktop.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "files": [
    "loading",
    "runtime",
    "scripts",
    "src-tauri/src",
    "src-tauri/capabilities",
    "src-tauri/icons",
    "src-tauri/Cargo.toml",
    "src-tauri/Cargo.lock",
    "src-tauri/build.rs",
    "src-tauri/entitlements.node.plist",
    "src-tauri/tauri.conf.json",
    "src-tauri/tauri.windows.conf.json",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "prepare-marketplace": "node scripts/prepare-marketplace.mjs",
    "smoke-runtime": "node scripts/smoke-runtime.mjs",
    "smoke-plugins": "node scripts/smoke-plugins.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@npmcli/run-script": "10.0.4",
    "@tauri-apps/cli": "2.11.4",
    "node-gyp": "12.4.0",
    "pnpm": "11.7.0"
  },
  "license": "MIT"
}
