{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qabas",
  "version": "0.1.5-rc.2",
  "identifier": "io.github.bestbbb.harness-desktop",
  "build": {
    "frontendDist": "../loading",
    "beforeBundleCommand": "node scripts/sign-runtime.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "title": "Qabas",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A community desktop distribution for DeepSeek Harness",
    "longDescription": "Qabas is a study app for medical students that turns lecture recordings, slides and past exam papers into transcripts and exam questions, built on DeepSeek Harness.",
    "resources": {
      "../resources/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
